{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "duel-synapse-kodex",
  "main": "worker.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [{ "name": "DUEL_ROOMS", "class_name": "DuelRoom" }]
  },
  "migrations": [{ "tag": "duel-rooms-v1", "new_sqlite_classes": ["DuelRoom"] }]
}
