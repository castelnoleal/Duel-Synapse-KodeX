{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "duel-synapse-kodex",
  "main": "server/worker.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "kodex.meiocg.org/api/*",
      "zone_name": "meiocg.org"
    },
    {
      "pattern": "kodex.meiocg.org/privacy-policy.html",
      "zone_name": "meiocg.org"
    },
    {
      "pattern": "kodex.meiocg.org/privacy-policy",
      "zone_name": "meiocg.org"
    },
    {
      "pattern": "kodex.meiocg.org/deck.html",
      "zone_name": "meiocg.org"
    },
    {
      "pattern": "kodex.meiocg.org/deck",
      "zone_name": "meiocg.org"
    },
    {
      "pattern": "kodex.meiocg.org/img/*",
      "zone_name": "meiocg.org"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DUEL_ROOMS",
        "class_name": "DuelRoom"
      },
      {
        "name": "DUEL_BOOKS",
        "class_name": "DuelBook"
      }
    ]
  },
  "migrations": [
    {
      "tag": "duel-rooms-v1",
      "new_sqlite_classes": [
        "DuelRoom"
      ]
    },
    {
      "tag": "duel-books-v1",
      "new_sqlite_classes": [
        "DuelBook"
      ]
    }
  ]
}
